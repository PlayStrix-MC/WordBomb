// wordbomb_arena: публичный экран арены WordBomb (один на всех, ставится плагином у голограммы из config.jmc).
// Файл создан плагином WordBomb один раз - дальше его правит сервер (редактор DisplayLib), плагин его не перезаписывает.
// Кнопки join / leave обрабатывает Java-плагин по id виджета (DisplayClickEvent), поэтому их id менять нельзя;
// всё остальное (цвета, позиции, тексты, новые надписи) - можно. Тексты state / players / timer обновляет
// функция render(...) скрипта wordbomb_arena.jmp.

String id = "wordbomb_arena";
String screenType = "PUBLIC";
int tickRate = 4;
double interactionRadius = 8;

dyn background = { color: [10, 10, 10], alpha: 200, scale: [15, 7.5, 1.25], anchor: "CENTER" };

String script = "wordbomb_arena.jmp";

dyn widgets = [
    {
        id: "title",
        type: "TEXT_BUTTON",
        text: [ { text: "Word", color: "#FFCC45" }, { text: "Bomb", color: "#FF6545" } ],
        position: [0, 0.625, -0.0125],
        scale: [1, 1, 1],
        tolerance: [0, 0],
    },
    {
        id: "state",
        type: "TEXT_BUTTON",
        text: [ { text: "Ожидание игроков", color: "white" } ],
        position: [0, 0.4175, -0.0125],
        scale: [0.5625, 0.5625, 0.5625],
        tolerance: [0, 0],
    },
    {
        id: "players",
        type: "TEXT_BUTTON",
        text: [ { text: "☻ 0", color: "#A1EFFF" } ],
        position: [-0.5, -0.0837, -0.0125],
        scale: [0.75, 0.75, 0.75],
        tolerance: [0, 0],
        tooltip: "Количество участников",
    },
    {
        id: "timer",
        type: "TEXT_BUTTON",
        text: [ { text: "⌚ -", color: "#A1EFFF" } ],
        position: [0.5, -0.0837, -0.0125],
        scale: [0.75, 0.75, 0.75],
        tolerance: [0, 0],
        tooltip: "Время до начала",
    },
    {
        id: "join",
        type: "TEXT_BUTTON",
        text: [ { text: "Играть", color: "#72DDFF" } ],
        clickSound: { sound: "ui.button.click", volume: 0.5, pitch: 1 },
        position: [-0.4912, -0.8125, -0.0125],
        scale: [0.75, 0.75, 0.75],
        tolerance: [0.3625, 0.1],
        backgroundColor: [0, 139, 241],
        backgroundAlpha: 200,
        tooltip: "Присоединиться к игре",
        onClick: true,
    },
    {
        id: "leave",
        type: "TEXT_BUTTON",
        text: [ { text: "Выйти", color: "#FFB3B3" } ],
        clickSound: { sound: "ui.button.click", volume: 0.5, pitch: 1 },
        position: [0.51, -0.8125, -0.0125],
        scale: [0.75, 0.75, 0.75],
        tolerance: [0.325, 0.0875],
        backgroundColor: [191, 0, 18],
        backgroundAlpha: 200,
        tooltip: "Покинуть очередь",
        onClick: true,
    },
];
